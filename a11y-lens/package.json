{
  "name": "a11y-lens",
  "version": "1.0.0",
  "private": true,
  "description": "A11y Lens — WCAG 2.2 accessibility checker plugin for Figma",
  "scripts": {
    "dev": "npm run build:code -- --watch & vite build --watch --config vite.config.ts",
    "build": "npm run typecheck && npm run build:ui && npm run build:code",
    "build:ui": "vite build --config vite.config.ts",
    "build:code": "esbuild src/code.ts --bundle --outfile=dist/code.js --target=es2017 --format=iife --legal-comments=none",
    "preview": "vite --config vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.109.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^2.1.8"
  }
}
