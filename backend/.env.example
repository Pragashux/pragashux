# Copy to .env — never commit secrets. Never put these in the Android app.

DATABASE_URL=sqlite:///./learnos.db
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRE_MINUTES=120
JWT_REFRESH_DAYS=14

# mock | openai
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# mock | stripe
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

STORAGE_DIR=./storage
FCM_SERVER_KEY=
APP_ENV=development
CORS_ORIGINS=http://127.0.0.1:*,http://localhost:*
